# --- Required for membership lookup (server) ---
SUPABASE_URL=https://qzunuksxwwzusyivaznx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_STAGING_SERVICE_ROLE_KEY

# --- Required for Firebase ID token verification (server) ---
